    sub = subparsers.add_parser("diagram", help="Generate wiring diagram SVG")
    sub.add_argument("-o", "--output", default=None, help="Output SVG path")

    # help
    subparsers.add_parser("help", help="Show help")

    args = parser.parse_args()

    commands = {
        "setup": cmd_setup,
        "flash": cmd_flash,
        "build": cmd_build,
        "map": cmd_map,
        "macro": cmd_macro,
        "profile": cmd_profile,
        "test": cmd_test,
        "status": cmd_status,
        "monitor": cmd_monitor,
        "ports": cmd_ports,
        "reset": cmd_reset,
        "keys": cmd_keys,
        "diagram": cmd_diagram,
        "help": cmd_help,
    }

    if not args.command:
        cmd_help()
        return

    commands[args.command](args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n")
