def _interactive_map(ser):
    """Interactive key mapping loop (shared by cmd_map and cmd_setup)."""
    codes = get_mappings(ser)
    if codes is None:
        print("  Could not read mappings from device.")
        return

    while True:
        print()
        print("  Current mappings:")
        print("  ─────────────────────────────")
        print_mappings(codes)
        print()
        print("  [1/2/3]  Change a button     [k] Show key list     [q] Done")
        print()

        choice = input("  > ").strip().lower()

        if choice in ("q", "quit", "exit", "done", ""):
            print()
            print("  Mappings saved on device.")
            break

        elif choice == "k":
            print_key_categories()

        elif choice in ("1", "2", "3"):
            btn_idx = int(choice) - 1
            current = code_to_display(codes[btn_idx])
            print(f"\n  Button {choice} is currently: {current}")
            print("  Enter a key name (e.g. mute, f13, play_pause, a)")
            print("  Type 'k' for the full list, or press Enter to cancel.")
            print()

            while True:
                key_input = input(f"  Button {choice} -> ").strip().lower()

                if key_input == "k":
                    print_key_categories()
                    continue
                if not key_input:
                    print("  (cancelled)")
                    break

                new_code = resolve_key(key_input)
                if new_code is None:
                    print(f"  Unknown key: '{key_input}'. Type 'k' for the list.")
                    continue

                codes[btn_idx] = new_code
                name = code_to_display(new_code)
                if set_mappings(ser, codes):
                    print(f"  Done! Button {choice} -> {name}")
                else:
                    print("  Error: could not save to device")
                break
        else:
            print("  Type 1, 2, 3, k, or q.")


def cmd_map(args):
    """Remap button keys."""
    if not ensure_pyserial():
        return

    # Non-interactive: --set
    if args.keys:
        if len(args.keys) != NUM_BUTTONS:
            print(f"  Error: provide exactly {NUM_BUTTONS} key names.")
            sys.exit(1)
        codes = []
        for k in args.keys:
            code = resolve_key(k)
            if code is None:
                print(f"  Unknown key: '{k}'")
                sys.exit(1)
            codes.append(code)
        ser, port = open_serial(args.port)
        if set_mappings(ser, codes):
            print("  Mappings saved:")
            print_mappings(codes)
        else:
            print("  Error: could not save to device")
        ser.close()
        return

    # Non-interactive: --get
    if args.get:
        ser, port = open_serial(args.port)
        codes = get_mappings(ser)
        if codes:
            print_mappings(codes)
        else:
            print("  Error: could not read mappings")
        ser.close()
        return

    # Interactive
    print()
    print("╔══════════════════════════════════╗")
    print("║       VibeKey Key Mapper         ║")
    print("╚══════════════════════════════════╝")

    ser, port = open_serial(args.port)
    if not is_vibekey(ser):
        print("  Warning: device did not respond as VibeKey.\n")

    try:
        _interactive_map(ser)
    except KeyboardInterrupt:
        print("\n")
    finally:
        ser.close()


def cmd_status(args):
    """Show device info and current mappings."""
    if not ensure_pyserial():
        return

    ser, port = open_serial(args.port)
    ok = is_vibekey(ser)
    codes = get_mappings(ser)
    ser.close()

    print()
    print(f"  Port:       {port}")
    print(f"  Device:     {'VibeKey (confirmed)' if ok else 'Unknown (no PONG response)'}")

    if codes:
        print(f"  Buttons:    {NUM_BUTTONS}")
        print()
        print("  Mappings:")
        print_mappings(codes)
    else:
        print("  Mappings:   could not read")
    print()


def cmd_flash(args):
    """Build and upload firmware."""
    env = args.env or "esp32s3"
    print()
    print(f"  Flashing VibeKey firmware (env: {env})")
    hr()
    try:
        do_flash(env=env, upload=not args.build_only, monitor=args.monitor)
        if not args.build_only:
            print()
            print("  Flash complete. Run 'vibekey status' to verify.")
    except subprocess.CalledProcessError:
        print("\n  Build/upload failed.")
        sys.exit(1)


def cmd_monitor(args):
    """Open serial monitor."""
    if not check_platformio():
        # Fallback: use pyserial
        if not ensure_pyserial():
            print("  Need PlatformIO or pyserial for serial monitor.")
            return
        ser, port = open_serial(args.port)
        print(f"  Serial monitor on {port} (Ctrl+C to exit)")
        hr()
        try:
            while True:
                if ser.in_waiting:
                    line = ser.readline().decode(errors="replace").rstrip()
                    print(f"  {line}")
                else:
                    time.sleep(0.01)
        except KeyboardInterrupt:
            print("\n  Monitor closed.")
        finally:
            ser.close()
    else:
        env = args.env or "esp32s3"
        subprocess.call(["pio", "device", "monitor", "-e", env], cwd=SCRIPT_DIR)


def cmd_ports(args):
    """List available serial ports."""
    if not ensure_pyserial():
        return
    import serial.tools.list_ports
    ports = serial.tools.list_ports.comports()
    if not ports:
        print("  No serial ports found.")
        return
    print()
    print("  Available serial ports:")
    hr()
    for p in ports:
        print(f"  {p.device:20s}  {p.description}")
    print()


def cmd_reset(args):
    """Reset key mappings to defaults."""
    if not ensure_pyserial():
        return

    defaults = [226, 234, 233]  # mute, volume_down, volume_up
    ser, port = open_serial(args.port)

    print()
    print("  Resetting to default mappings:")
    print_mappings(defaults)

    if not args.yes:
        if not ask_yn("\n  Confirm reset?"):
            print("  Cancelled.")
            ser.close()
            return

    if set_mappings(ser, defaults):
        print("\n  Reset complete.")
    else:
        print("\n  Error: could not write to device.")
    ser.close()


def cmd_keys(args):
    """Show all available key names."""
    print()
    print("  Available key names for mapping:")
    print_key_categories()
    print()


