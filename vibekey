def _interactive_map(ser):
    """Interactive key mapping loop (shared by cmd_map and cmd_setup)."""
    codes = get_mappings(ser)
    if codes is None:
        print("  Could not read mappings from device.")
        return

    while True:
        print()
        print("  Current mappings:")
        print("  ─────────────────────────────")
        print_mappings(codes)
        print()
        print("  [1/2/3]  Change a button     [k] Show key list     [q] Done")
        print()

        choice = input("  > ").strip().lower()

        if choice in ("q", "quit", "exit", "done", ""):
            print()
            print("  Mappings saved on device.")
            break

        elif choice == "k":
            print_key_categories()

        elif choice in ("1", "2", "3"):
            btn_idx = int(choice) - 1
            current = code_to_display(codes[btn_idx])
            print(f"\n  Button {choice} is currently: {current}")
            print("  Enter a key name (e.g. mute, f13, play_pause, a)")
            print("  Type 'k' for the full list, or press Enter to cancel.")
            print()

            while True:
                key_input = input(f"  Button {choice} -> ").strip().lower()

                if key_input == "k":
                    print_key_categories()
                    continue
                if not key_input:
                    print("  (cancelled)")
                    break

                new_code = resolve_key(key_input)
                if new_code is None:
                    print(f"  Unknown key: '{key_input}'. Type 'k' for the list.")
                    continue

                codes[btn_idx] = new_code
                name = code_to_display(new_code)
                if set_mappings(ser, codes):
                    print(f"  Done! Button {choice} -> {name}")
                else:
                    print("  Error: could not save to device")
                break
        else:
            print("  Type 1, 2, 3, k, or q.")


def cmd_map(args):
    """Remap button keys."""
    if not ensure_pyserial():
        return

    # Non-interactive: --set
    if args.keys:
        if len(args.keys) != NUM_BUTTONS:
            print(f"  Error: provide exactly {NUM_BUTTONS} key names.")
            sys.exit(1)
        codes = []
        for k in args.keys:
            code = resolve_key(k)
            if code is None:
                print(f"  Unknown key: '{k}'")
                sys.exit(1)
            codes.append(code)
        ser, port = open_serial(args.port)
        if set_mappings(ser, codes):
            print("  Mappings saved:")
            print_mappings(codes)
        else:
            print("  Error: could not save to device")
        ser.close()
        return

    # Non-interactive: --get
    if args.get:
        ser, port = open_serial(args.port)
        codes = get_mappings(ser)
        if codes:
            print_mappings(codes)
        else:
            print("  Error: could not read mappings")
        ser.close()
        return

    # Interactive
    print()
    print("╔══════════════════════════════════╗")
    print("║       VibeKey Key Mapper         ║")
    print("╚══════════════════════════════════╝")

    ser, port = open_serial(args.port)
    if not is_vibekey(ser):
        print("  Warning: device did not respond as VibeKey.\n")

    try:
        _interactive_map(ser)
    except KeyboardInterrupt:
        print("\n")
    finally:
        ser.close()


def cmd_macro(args):
    """Set a multi-key macro on a button."""
    if not ensure_pyserial():
        return

    btn = args.button
    if btn < 1 or btn > NUM_BUTTONS:
        print(f"  Error: button must be 1-{NUM_BUTTONS}")
        sys.exit(1)
    btn_idx = btn - 1

    ser, port = open_serial(args.port)

    if args.clear:
        lines = send_command(ser, f"CLEARMACRO {btn_idx}")
        if any("OK" in l for l in lines):
            print(f"  Macro cleared for button {btn}.")
        else:
            print("  Error clearing macro.")
        ser.close()
        return

    if args.get:
        lines = send_command(ser, f"GETMACRO {btn_idx}")
        for line in lines:
            if line.startswith("MACRO:"):
                parts = line.split(":")
                num_steps = int(parts[2])
                if num_steps == 0:
                    print(f"  Button {btn}: no macro (single key mode)")
                else:
                    steps_str = parts[3] if len(parts) > 3 else ""
                    print(f"  Button {btn} macro ({num_steps} steps): {steps_str}")
        ser.close()
        return

    if not args.steps:
        print("  Error: provide macro steps.")
        print("  Example: vibekey macro 1 left_ctrl+c")
        print("  Example: vibekey macro 2 left_ctrl+left_shift+m")
        print("  Example: vibekey macro 1 left_ctrl+a 0 left_ctrl+c")
        print("    (0 = pause between steps)")
        ser.close()
        sys.exit(1)

    # Parse steps: each arg is "modifier+key" or "key" or "0" for pause
    encoded_steps = []
    for step_str in args.steps:
        step_str = step_str.strip().lower()
        if step_str == "0":
            encoded_steps.append("0")
            continue
        parts = step_str.split("+")
        if len(parts) == 1:
            code = resolve_key(parts[0])
            if code is None:
                print(f"  Unknown key: '{parts[0]}'")
                ser.close()
                sys.exit(1)
            encoded_steps.append(str(code))
        else:
            # Last part is the key, everything before is modifiers
            key_code = resolve_key(parts[-1])
            if key_code is None:
                print(f"  Unknown key: '{parts[-1]}'")
                ser.close()
                sys.exit(1)
            # Combine all modifier codes by OR-ing (for the protocol, we
            # only support one modifier byte, so use the last modifier)
            mod_code = resolve_key(parts[0])
            if mod_code is None:
                print(f"  Unknown modifier: '{parts[0]}'")
                ser.close()
                sys.exit(1)
            encoded_steps.append(f"{mod_code}+{key_code}")

    cmd = f"MACRO {btn_idx} " + ",".join(encoded_steps)
    lines = send_command(ser, cmd)
    if any("OK" in l for l in lines):
        print(f"  Macro set for button {btn}:")
        for step_str in args.steps:
            print(f"    {step_str}")
    else:
        print("  Error setting macro.")
        for line in lines:
            print(f"    {line}")
    ser.close()


def cmd_profile(args):
    """Switch between mapping profiles."""
    if not ensure_pyserial():
        return

    ser, port = open_serial(args.port)

    if args.number is not None:
        n = args.number
        if n < 0 or n >= NUM_PROFILES:
            print(f"  Error: profile must be 0-{NUM_PROFILES - 1}")
            ser.close()
            sys.exit(1)
        if set_profile(ser, n):
            codes = get_mappings(ser)
            print(f"  Switched to profile {n}")
            if codes:
                print_mappings(codes)
        else:
            print("  Error switching profile.")
    else:
        p = get_profile(ser)
        codes = get_mappings(ser)
        print()
        print(f"  Active profile: {p}/{NUM_PROFILES - 1}")
        if codes:
            print()
            print_mappings(codes)
        print()
        print(f"  Switch with: vibekey profile <0-{NUM_PROFILES - 1}>")
        print("  Or hold Button 1 + Button 3 during boot to cycle.")

    ser.close()
    print()


def cmd_test(args):
    """Simulate button presses without hardware.

    Connects to the device and sends GET to read mappings,
    then lets you "press" buttons to see what would be sent.
    If --offline, simulates entirely without a device.
    """
    print()
    print("╔══════════════════════════════════╗")
    print("║      VibeKey Test Mode           ║")
    print("╚══════════════════════════════════╝")
    print()

    if args.offline:
        # Offline simulation — no device needed
        defaults = {0: 226, 1: 234, 2: 233}  # mute, vol_down, vol_up
        print("  Offline mode — using default mappings:")
        print_mappings(list(defaults.values()))
        print()
        print("  Press 1, 2, or 3 to simulate a button press.")
        print("  Press q to quit.")
        print()

        while True:
            choice = input("  [test] > ").strip().lower()
            if choice in ("q", "quit", ""):
                break
            if choice in ("1", "2", "3"):
                idx = int(choice) - 1
                code = defaults[idx]
                name = code_to_display(code)
                print(f"  [SIM] Button {choice} DOWN")
                print(f"  [SIM]   -> would send: {name} (code {code})")
                print(f"  [SIM] Button {choice} UP")
            else:
                print("  Type 1, 2, 3, or q.")
        print()
        return

    # Online test — read from device, simulate presses
    if not ensure_pyserial():
        return

    ser, port = open_serial(args.port)
    ok = is_vibekey(ser)
    codes = get_mappings(ser)

    if not ok:
        print("  Warning: device did not respond as VibeKey.\n")
    if codes is None:
        print("  Could not read mappings.")
        ser.close()
        return

    # Check for macros
    macros = {}
    for i in range(NUM_BUTTONS):
        lines = send_command(ser, f"GETMACRO {i}")
        for line in lines:
            if line.startswith("MACRO:"):
                parts = line.split(":")
                num_steps = int(parts[2])
                if num_steps > 0:
                    macros[i] = parts[3] if len(parts) > 3 else ""

    profile = get_profile(ser)
    ser.close()

    print(f"  Connected to {port} (profile {profile})")
    print()
    print("  Current mappings:")
    print("  ─────────────────────────────")
    for i, code in enumerate(codes):
        name = code_to_display(code)
        macro_info = f"  [macro: {macros[i]}]" if i in macros else ""
        print(f"  Button {i + 1}  ->  {name}  (code {code}){macro_info}")
    print()
    print("  Press 1, 2, or 3 to simulate. Press q to quit.")
    print()

    while True:
        choice = input("  [test] > ").strip().lower()
        if choice in ("q", "quit", ""):
            break
        if choice in ("1", "2", "3"):
            idx = int(choice) - 1
            code = codes[idx]
            name = code_to_display(code)
            print(f"  [SIM] Button {choice} DOWN")
            if idx in macros:
                print(f"  [SIM]   -> macro: {macros[idx]}")
            else:
                print(f"  [SIM]   -> would send: {name} (code {code})")
            print(f"  [SIM] Button {choice} UP")
        else:
            print("  Type 1, 2, 3, or q.")
    print()


def cmd_build(args):
    """Build firmware and export .bin files."""
    if not check_platformio():
        print("  PlatformIO (pio) is not installed.")
        print("  Install with: pip install platformio")
        sys.exit(1)

    env = args.env or "esp32s3"
    prepare_src()

    print()
    print(f"  Building firmware (env: {env})...")
    hr()
    subprocess.check_call(["pio", "run", "-e", env], cwd=SCRIPT_DIR)

    # Find the built binary
    build_dir = os.path.join(SCRIPT_DIR, ".pio", "build", env)
    bin_file = os.path.join(build_dir, "firmware.bin")

    if not os.path.exists(bin_file):
        print("\n  Build succeeded but firmware.bin not found.")
        print(f"  Check: {build_dir}")
        sys.exit(1)

    # Copy to output directory
    out_dir = os.path.join(SCRIPT_DIR, "build")
    os.makedirs(out_dir, exist_ok=True)
    out_name = f"vibekey-{env}.bin"
    out_path = os.path.join(out_dir, out_name)
    shutil.copy2(bin_file, out_path)

    # Also copy bootloader and partitions if they exist (for esptool)
    for extra in ["bootloader.bin", "partitions.bin"]:
        src = os.path.join(build_dir, extra)
        if os.path.exists(src):
            shutil.copy2(src, os.path.join(out_dir, f"vibekey-{env}-{extra}"))

    size_kb = os.path.getsize(out_path) / 1024
    print()
    print(f"  Firmware binary exported:")
    print(f"    {out_path}  ({size_kb:.1f} KB)")
    print()
    print("  Flash without PlatformIO using esptool:")
    print(f"    pip install esptool")
    print(f"    esptool.py --chip esp32s3 write_flash 0x10000 {out_path}")
    print()


