def cmd_diagram(args):
    """Generate a wiring diagram as SVG."""
    out_path = args.output or os.path.join(SCRIPT_DIR, "docs", "wiring-diagram.svg")
    os.makedirs(os.path.dirname(out_path), exist_ok=True)

    gpio_pins = ["GPIO 4", "GPIO 5", "GPIO 6"]
    btn_labels = ["BTN 1", "BTN 2", "BTN 3"]

    svg_width = 600
    svg_height = 420

    # Layout
    esp_x, esp_y = 220, 280
    esp_w, esp_h = 160, 100
    sw_y = 60
    sw_spacing = 170
    sw_start_x = 80

    lines = []
    lines.append(f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {svg_width} {svg_height}" '
                 f'font-family="monospace" font-size="12">')
    lines.append('<style>')
    lines.append('  .wire-signal { stroke: #2563eb; stroke-width: 2; fill: none; }')
    lines.append('  .wire-gnd { stroke: #333; stroke-width: 2; fill: none; stroke-dasharray: 6,3; }')
    lines.append('  .switch { fill: #f8fafc; stroke: #334155; stroke-width: 2; rx: 4; }')
    lines.append('  .esp { fill: #ecfdf5; stroke: #059669; stroke-width: 2; rx: 6; }')
    lines.append('  .label { font-size: 11px; fill: #1e293b; text-anchor: middle; }')
    lines.append('  .pin-label { font-size: 10px; fill: #2563eb; text-anchor: middle; }')
    lines.append('  .gnd-label { font-size: 10px; fill: #666; text-anchor: middle; }')
    lines.append('  .title { font-size: 16px; font-weight: bold; fill: #0f172a; text-anchor: middle; }')
    lines.append('  .subtitle { font-size: 11px; fill: #64748b; text-anchor: middle; }')
    lines.append('</style>')

    # Title
    lines.append(f'<text x="{svg_width//2}" y="25" class="title">VibeKey Wiring Diagram</text>')
    lines.append(f'<text x="{svg_width//2}" y="42" class="subtitle">'
                 f'3 MX switches + ESP32-S3</text>')

    # ESP32 box
    lines.append(f'<rect x="{esp_x}" y="{esp_y}" width="{esp_w}" height="{esp_h}" class="esp"/>')
    lines.append(f'<text x="{esp_x + esp_w//2}" y="{esp_y + 25}" class="label" '
                 f'font-weight="bold" font-size="13">ESP32-S3</text>')
    lines.append(f'<text x="{esp_x + esp_w//2}" y="{esp_y + 42}" class="label" '
                 f'font-size="10">DevKitC-1</text>')

    # USB-C at bottom
    usb_w, usb_h = 40, 14
    usb_x = esp_x + (esp_w - usb_w) // 2
    usb_y = esp_y + esp_h - 2
    lines.append(f'<rect x="{usb_x}" y="{usb_y}" width="{usb_w}" height="{usb_h}" '
                 f'fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" rx="3"/>')
    lines.append(f'<text x="{usb_x + usb_w//2}" y="{usb_y + 11}" '
                 f'font-size="8" text-anchor="middle" fill="#475569">USB-C</text>')

    # Draw 3 switches and wires
    for i in range(3):
        sx = sw_start_x + i * sw_spacing
        sw_w, sw_h = 70, 50

        # Switch box
        lines.append(f'<rect x="{sx}" y="{sw_y}" width="{sw_w}" height="{sw_h}" class="switch"/>')
        lines.append(f'<text x="{sx + sw_w//2}" y="{sw_y + 20}" class="label" '
                     f'font-weight="bold">{btn_labels[i]}</text>')
        lines.append(f'<text x="{sx + sw_w//2}" y="{sw_y + 35}" class="label" '
                     f'font-size="9">MX Switch</text>')

        # Pin A (signal) — left side of switch
        pin_a_x = sx + 18
        pin_a_y = sw_y + sw_h

        # Pin B (GND) — right side of switch
        pin_b_x = sx + sw_w - 18
        pin_b_y = sw_y + sw_h

        # Small circles for pins
        lines.append(f'<circle cx="{pin_a_x}" cy="{pin_a_y}" r="3" fill="#2563eb"/>')
        lines.append(f'<circle cx="{pin_b_x}" cy="{pin_b_y}" r="3" fill="#333"/>')

        # Signal wire from pin A down to ESP32
        gpio_target_x = esp_x + 30 + i * 45
        gpio_target_y = esp_y
        mid_y = sw_y + sw_h + 30 + i * 20
        lines.append(f'<path d="M{pin_a_x},{pin_a_y} L{pin_a_x},{mid_y} '
                     f'L{gpio_target_x},{mid_y} L{gpio_target_x},{gpio_target_y}" '
                     f'class="wire-signal"/>')
        lines.append(f'<text x="{gpio_target_x}" y="{gpio_target_y - 5}" '
                     f'class="pin-label">{gpio_pins[i]}</text>')

    # GND daisy-chain wire
    gnd_y = sw_y + sw_h + 15
    first_gnd_x = sw_start_x + 70 - 18
    last_gnd_x = sw_start_x + 2 * sw_spacing + 70 - 18
    gnd_esp_x = esp_x + esp_w - 20
    gnd_esp_y = esp_y

    # Vertical from each switch GND pin to the daisy chain line
    for i in range(3):
        pin_b_x = sw_start_x + i * sw_spacing + 70 - 18
        pin_b_y = sw_y + 50
        lines.append(f'<path d="M{pin_b_x},{pin_b_y} L{pin_b_x},{gnd_y}" class="wire-gnd"/>')

    # Horizontal daisy chain
    lines.append(f'<path d="M{first_gnd_x},{gnd_y} L{last_gnd_x},{gnd_y}" class="wire-gnd"/>')

    # Down to ESP32 GND
    lines.append(f'<path d="M{last_gnd_x},{gnd_y} L{gnd_esp_x},{gnd_y} '
                 f'L{gnd_esp_x},{gnd_esp_y}" class="wire-gnd"/>')
    lines.append(f'<text x="{gnd_esp_x}" y="{gnd_esp_y - 5}" class="gnd-label">GND</text>')

    # Legend
    leg_x, leg_y = 10, svg_height - 45
    lines.append(f'<line x1="{leg_x}" y1="{leg_y}" x2="{leg_x+30}" y2="{leg_y}" '
                 f'class="wire-signal"/>')
    lines.append(f'<text x="{leg_x+35}" y="{leg_y+4}" font-size="10" fill="#1e293b">'
                 f'Signal (GPIO)</text>')
    lines.append(f'<line x1="{leg_x}" y1="{leg_y+18}" x2="{leg_x+30}" y2="{leg_y+18}" '
                 f'class="wire-gnd"/>')
    lines.append(f'<text x="{leg_x+35}" y="{leg_y+22}" font-size="10" fill="#1e293b">'
                 f'Ground (GND)</text>')

    lines.append('</svg>')

    svg_content = "\n".join(lines)
    with open(out_path, "w") as f:
        f.write(svg_content)

    print(f"  Wiring diagram saved to: {out_path}")
    print(f"  Open in a browser or SVG viewer.")
    print()


