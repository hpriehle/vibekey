#!/usr/bin/env python3
"""
vibekey — CLI for setting up and managing your VibeKey keyboard
===============================================================

Commands:
    vibekey setup       Guided first-time onboarding
    vibekey flash       Build and upload firmware to ESP32
    vibekey map         Remap button keys (interactive or CLI)
    vibekey status      Show device info and current mappings
    vibekey monitor     Open serial monitor (live debug output)
    vibekey ports       List available serial ports
    vibekey reset       Reset key mappings to defaults
    vibekey keys        Show all available key names
    vibekey help        Show this help

Run 'vibekey setup' to get started with a new build.
"""

import os
import sys
import time
import shutil
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
FIRMWARE_DIR = os.path.join(SCRIPT_DIR, "firmware")
PIO_INI = os.path.join(SCRIPT_DIR, "platformio.ini")
SRC_DIR = os.path.join(SCRIPT_DIR, "src")
BAUD = 115200

