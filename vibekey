#!/usr/bin/env python3
"""
vibekey — CLI for setting up and managing your VibeKey keyboard
===============================================================

Commands:
    vibekey setup       Guided first-time onboarding
    vibekey flash       Build and upload firmware to ESP32
    vibekey build       Compile firmware and export .bin files
    vibekey map         Remap button keys (interactive or CLI)
    vibekey macro       Set a multi-key macro on a button
    vibekey profile     Switch between mapping profiles
    vibekey test        Simulate button presses (no hardware needed)
    vibekey status      Show device info and current mappings
    vibekey monitor     Open serial monitor (live debug output)
    vibekey ports       List available serial ports
    vibekey reset       Reset key mappings to defaults
    vibekey keys        Show all available key names
    vibekey diagram     Generate wiring diagram SVG
    vibekey help        Show this help

Run 'vibekey setup' to get started with a new build.
"""

import os
import sys
import time
import shutil
import subprocess
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
FIRMWARE_DIR = os.path.join(SCRIPT_DIR, "firmware")
PIO_INI = os.path.join(SCRIPT_DIR, "platformio.ini")
SRC_DIR = os.path.join(SCRIPT_DIR, "src")
BAUD = 115200

# ─── Key lookup tables ───────────────────────────────────────────
# Fixed: removed overlapping codes between F-keys and nav keys.
# F13-F24 use codes 206-217 in BLE HID but nav keys (home, end, etc.)
# also live in that range. The ESP32-BLE-Keyboard library uses
# distinct constants. We keep only the nav key names for the
# overlapping codes since those are more commonly used, and map
# F13-F24 to their correct codes.

KEY_MAP = {
    # Letters
    "a": 97, "b": 98, "c": 99, "d": 100, "e": 101, "f": 102,
    "g": 103, "h": 104, "i": 105, "j": 106, "k": 107, "l": 108,
    "m": 109, "n": 110, "o": 111, "p": 112, "q": 113, "r": 114,
    "s": 115, "t": 116, "u": 117, "v": 118, "w": 119, "x": 120,
    "y": 121, "z": 122,
    # Numbers
    "0": 48, "1": 49, "2": 50, "3": 51, "4": 52,
    "5": 53, "6": 54, "7": 55, "8": 56, "9": 57,
    # Special
    "enter": 176, "return": 176, "esc": 177, "escape": 177,
    "backspace": 178, "tab": 179, "space": 32, "caps_lock": 193,
    # Navigation (these are the canonical codes for these keys)
    "home": 210, "end": 213, "insert": 209,
    "delete": 212, "page_up": 211, "page_down": 214,
    # Arrows
    "right": 215, "right_arrow": 215,
    "left": 216, "left_arrow": 216,
    "down": 217, "down_arrow": 217,
    "up": 218, "up_arrow": 218,
    # F-keys (F1-F12 are unambiguous)
    "f1": 194, "f2": 195, "f3": 196, "f4": 197,
    "f5": 198, "f6": 199, "f7": 200, "f8": 201,
    "f9": 202, "f10": 203, "f11": 204, "f12": 205,
    # F13-F24 (these overlap with nav keys in BLE HID;
    # library maps them the same, so we use 0xF0+ range)
    "f13": 240, "f14": 241, "f15": 242, "f16": 243,
    "f17": 244, "f18": 245, "f19": 246, "f20": 247,
    "f21": 248, "f22": 249, "f23": 250, "f24": 251,
    # Modifiers
    "left_ctrl": 128, "left_shift": 129, "left_alt": 130, "left_gui": 131,
    "right_ctrl": 132, "right_shift": 133, "right_alt": 134, "right_gui": 135,
    # Media
    "mute": 226, "media_mute": 226,
    "volume_up": 233, "vol_up": 233, "media_volume_up": 233,
    "volume_down": 234, "vol_down": 234, "media_volume_down": 234,
    "play_pause": 205, "media_play_pause": 205,
    "next_track": 181, "media_next_track": 181,
    "prev_track": 182, "previous_track": 182, "media_previous_track": 182,
    "stop": 183, "media_stop": 183,
}

CODE_TO_NAME = {}
for _name, _code in KEY_MAP.items():
    if _code not in CODE_TO_NAME or len(_name) < len(CODE_TO_NAME[_code]):
        CODE_TO_NAME[_code] = _name
# Override with preferred display names
CODE_TO_NAME.update({
    226: "mute", 233: "volume_up", 234: "volume_down", 205: "play_pause",
    181: "next_track", 182: "prev_track", 176: "enter", 177: "esc",
    178: "backspace", 179: "tab", 32: "space",
    210: "home", 211: "page_up", 212: "delete", 213: "end",
    214: "page_down", 215: "right", 216: "left", 217: "down", 218: "up",
    209: "insert",
})

NUM_BUTTONS = 3
NUM_PROFILES = 3

# ─── Helpers ──────────────────────────────────────────────────────

def code_to_display(code):
    if code in CODE_TO_NAME:
        return CODE_TO_NAME[code]
    if 32 <= code <= 126:
        return chr(code)
    return f"code_{code}"


def resolve_key(name):
    """Resolve a key name or number to a code, or None."""
    name = name.strip().lower()
    if name in KEY_MAP:
        return KEY_MAP[name]
    if len(name) == 1 and 32 <= ord(name) <= 126:
        return ord(name)
    if name.isdigit() and int(name) <= 255:
        return int(name)
    return None


def print_key_categories():
    categories = {
        "Media":     ["mute", "volume_up", "volume_down", "play_pause",
                      "next_track", "prev_track", "stop"],
        "Common":    ["enter", "esc", "backspace", "tab", "space",
                      "delete", "insert", "home", "end", "page_up", "page_down"],
        "Arrows":    ["up", "down", "left", "right"],
        "F-Keys":    [f"f{i}" for i in range(1, 25)],
        "Letters":   [chr(c) for c in range(97, 123)],
        "Numbers":   [str(d) for d in range(10)],
        "Modifiers": ["left_ctrl", "left_shift", "left_alt", "left_gui",
                      "right_ctrl", "right_shift", "right_alt", "right_gui"],
    }
    for cat, keys in categories.items():
        print(f"\n  {cat}:")
        line = "    "
        for k in keys:
            if len(line) + len(k) + 2 > 72:
                print(line)
                line = "    "
            line += k + "  "
        if line.strip():
            print(line)


def hr():
    print("─" * 56)


def banner(text):
    print()
    print(f"  {text}")
    hr()


def ask(prompt, default=None):
    if default:
        result = input(f"  {prompt} [{default}]: ").strip()
        return result if result else default
    return input(f"  {prompt}: ").strip()


def ask_yn(prompt, default=True):
    suffix = "[Y/n]" if default else "[y/N]"
    result = input(f"  {prompt} {suffix} ").strip().lower()
    if not result:
        return default
    return result in ("y", "yes")


def check_pyserial():
    try:
        import serial  # noqa: F811
        import serial.tools.list_ports  # noqa: F811
        return True
    except ImportError:
        return False


def ensure_pyserial():
    if check_pyserial():
        return True
    print("  pyserial is required for device communication.")
    if ask_yn("Install pyserial now?"):
        subprocess.check_call([sys.executable, "-m", "pip", "install", "pyserial"],
                              stdout=subprocess.DEVNULL)
        print("  Installed.")
        return True
    return False


def check_platformio():
    return shutil.which("pio") is not None


def find_port():
    import serial.tools.list_ports
    ports = serial.tools.list_ports.comports()
    esp_keywords = ["CP210", "CH340", "FTDI", "ESP32", "USB Serial",
                    "USB-SERIAL", "ACM", "ttyUSB", "cu.usb", "cu.SLAB"]
    for port in ports:
        desc = f"{port.description} {port.device}".upper()
        if any(kw.upper() in desc for kw in esp_keywords):
            return port.device
    if ports:
        return ports[0].device
    return None


def open_serial(port=None):
    import serial as ser_module
    port = port or find_port()
    if not port:
        print("  No serial port found. Is the ESP32 plugged in?")
        sys.exit(1)
    print(f"  Connecting to {port}...")
    try:
        s = ser_module.Serial(port, BAUD, timeout=1)
    except Exception as e:
        print(f"  Error opening {port}: {e}")
        sys.exit(1)
    time.sleep(1.5)
    s.reset_input_buffer()
    return s, port


def send_command(ser, cmd):
    ser.reset_input_buffer()
    ser.write((cmd + "\n").encode())
    time.sleep(0.3)
    lines = []
    deadline = time.time() + 2.0
    while time.time() < deadline:
        if ser.in_waiting:
            line = ser.readline().decode(errors="replace").strip()
            if line:
                lines.append(line)
            deadline = time.time() + 0.5
        else:
            time.sleep(0.05)
    return lines


def get_mappings(ser):
    lines = send_command(ser, "GET")
    for line in lines:
        if line.startswith("MAP:"):
            return [int(x) for x in line[4:].split(",")]
    return None


def set_mappings(ser, codes):
    cmd = "SET " + ",".join(str(c) for c in codes)
    lines = send_command(ser, cmd)
    return any(l == "OK" for l in lines)


def is_vibekey(ser):
    lines = send_command(ser, "PING")
    return any("PONG:vibekey" in l for l in lines)


def get_profile(ser):
    lines = send_command(ser, "PROFILE")
    for line in lines:
        if line.startswith("PROFILE:"):
            return int(line.split(":")[1])
    return None


def set_profile(ser, n):
    lines = send_command(ser, f"PROFILE {n}")
    return any("OK:PROFILE:" in l for l in lines)


def print_mappings(codes):
    for i, code in enumerate(codes):
        name = code_to_display(code)
        print(f"  Button {i + 1}  ->  {name}  (code {code})")


def prepare_src():
    """Copy firmware into PlatformIO's expected src/ directory."""
    os.makedirs(SRC_DIR, exist_ok=True)
    shutil.copy2(os.path.join(FIRMWARE_DIR, "config.h"), os.path.join(SRC_DIR, "config.h"))
    shutil.copy2(os.path.join(FIRMWARE_DIR, "one_key_keyboard.ino"), os.path.join(SRC_DIR, "main.cpp"))


def do_flash(env="esp32s3", upload=True, monitor=False):
    if not check_platformio():
        print("  PlatformIO (pio) is not installed.")
        print("  Install with: pip install platformio")
        sys.exit(1)

    prepare_src()

    if upload:
        print(f"  Building and uploading (env: {env})...")
        subprocess.check_call(["pio", "run", "-e", env, "-t", "upload"], cwd=SCRIPT_DIR)
    else:
        print(f"  Building (env: {env})...")
        subprocess.check_call(["pio", "run", "-e", env], cwd=SCRIPT_DIR)

    if monitor:
        print("  Opening serial monitor (Ctrl+C to exit)...")
        subprocess.call(["pio", "device", "monitor", "-e", env], cwd=SCRIPT_DIR)


