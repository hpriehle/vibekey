def main():
    parser = argparse.ArgumentParser(
        prog="vibekey",
        description="CLI for setting up and managing your VibeKey keyboard",
        add_help=False,
    )
    parser.add_argument("--port", "-p", default=None, help="Serial port")

    subparsers = parser.add_subparsers(dest="command")

    # setup
    subparsers.add_parser("setup", help="Guided first-time setup")

    # flash
    sub = subparsers.add_parser("flash", help="Build and upload firmware")
    sub.add_argument("--env", default=None, help="PlatformIO environment")
    sub.add_argument("--build-only", action="store_true", help="Build without uploading")
    sub.add_argument("--monitor", action="store_true", help="Open serial monitor after")

    # build
    sub = subparsers.add_parser("build", help="Compile and export .bin files")
    sub.add_argument("--env", default=None, help="PlatformIO environment")

    # map
    sub = subparsers.add_parser("map", help="Remap button keys")
    sub.add_argument("keys", nargs="*", default=None, help="Key names")
    sub.add_argument("--get", action="store_true", help="Print current mappings")

    # macro
    sub = subparsers.add_parser("macro", help="Set multi-key macros")
    sub.add_argument("button", type=int, help="Button number (1-3)")
    sub.add_argument("steps", nargs="*", default=None, help="Macro steps (e.g. left_ctrl+c)")
    sub.add_argument("--get", action="store_true", help="Show macro for button")
    sub.add_argument("--clear", action="store_true", help="Clear macro for button")

    # profile
    sub = subparsers.add_parser("profile", help="Switch mapping profiles")
    sub.add_argument("number", type=int, nargs="?", default=None, help="Profile number (0-2)")

    # test
    sub = subparsers.add_parser("test", help="Simulate button presses")
    sub.add_argument("--offline", action="store_true", help="Simulate without device")

    # status
    subparsers.add_parser("status", help="Show device info and mappings")

    # monitor
    sub = subparsers.add_parser("monitor", help="Live serial output")
    sub.add_argument("--env", default=None, help="PlatformIO environment")

