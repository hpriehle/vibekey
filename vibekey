def main():
    parser = argparse.ArgumentParser(
        prog="vibekey",
        description="CLI for setting up and managing your VibeKey keyboard",
        add_help=False,
    )
    parser.add_argument("--port", "-p", default=None, help="Serial port")

    subparsers = parser.add_subparsers(dest="command")

    # setup
    sub = subparsers.add_parser("setup", help="Guided first-time setup")

    # flash
    sub = subparsers.add_parser("flash", help="Build and upload firmware")
    sub.add_argument("--env", default=None, help="PlatformIO environment")
    sub.add_argument("--build-only", action="store_true", help="Build without uploading")
    sub.add_argument("--monitor", action="store_true", help="Open serial monitor after")

    # map
    sub = subparsers.add_parser("map", help="Remap button keys")
    sub.add_argument("keys", nargs="*", default=None, help="Key names (e.g. mute vol_down vol_up)")
    sub.add_argument("--get", action="store_true", help="Print current mappings")

    # status
    subparsers.add_parser("status", help="Show device info and mappings")

    # monitor
    sub = subparsers.add_parser("monitor", help="Live serial output")
    sub.add_argument("--env", default=None, help="PlatformIO environment")

    # ports
    subparsers.add_parser("ports", help="List serial ports")

    # reset
    sub = subparsers.add_parser("reset", help="Reset mappings to defaults")
    sub.add_argument("-y", "--yes", action="store_true", help="Skip confirmation")

    # keys
    subparsers.add_parser("keys", help="Show available key names")

    # help
    subparsers.add_parser("help", help="Show help")

    args = parser.parse_args()

    commands = {
        "setup": cmd_setup,
        "flash": cmd_flash,
        "map": cmd_map,
        "status": cmd_status,
        "monitor": cmd_monitor,
        "ports": cmd_ports,
        "reset": cmd_reset,
        "keys": cmd_keys,
        "help": cmd_help,
    }

    if not args.command:
        cmd_help()
        return

    commands[args.command](args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n")
        sys.exit(0)
