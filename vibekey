def cmd_monitor(args):
    """Open serial monitor."""
    if not check_platformio():
        if not ensure_pyserial():
            print("  Need PlatformIO or pyserial for serial monitor.")
            return
        ser, port = open_serial(args.port)
        print(f"  Serial monitor on {port} (Ctrl+C to exit)")
        hr()
        try:
            while True:
                if ser.in_waiting:
                    line = ser.readline().decode(errors="replace").rstrip()
                    print(f"  {line}")
                else:
                    time.sleep(0.01)
        except KeyboardInterrupt:
            print("\n  Monitor closed.")
        finally:
            ser.close()
    else:
        env = args.env or "esp32s3"
        subprocess.call(["pio", "device", "monitor", "-e", env], cwd=SCRIPT_DIR)


